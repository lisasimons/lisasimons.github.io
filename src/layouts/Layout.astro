---
import { getEntry } from "astro:content";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import config from "@/config";

// Page title and description (for Google) still come from src/content/pages/about.md
const about = await getEntry("pages", "about");

const linkedIn = "https://www.linkedin.com/in/lisasimons/";

const areas = [
  {
    name: "Business analysis",
    items: [
      "Business analysis techniques and practices",
      "Agile Product Owner deliverables",
      "Issue, risk and change management",
      "BA team leadership",
    ],
  },
  {
    name: "Product thinking",
    items: [
      "Product management principles in practice",
      "As-is and to-be assessments",
      "Aligning delivery with strategy",
    ],
  },
  {
    name: "Information architecture",
    items: [
      "Project frameworks and governance",
      "Service blueprints",
      "Operational design",
      "Enterprise standards and workspace design",
    ],
  },
  {
    name: "Consulting",
    items: [
      "Insights and recommendations",
      "Options evaluation",
      "Solution proposals",
    ],
  },
];

const career = [
  {
    role: "Electrical engineer",
    detail: "Started in control systems engineering.",
  },
  {
    role: "Business analyst",
    detail: "Moved into business analysis for technology projects.",
  },
  {
    role: "Analyst team lead",
    detail: "Led analyst teams in Sydney and London.",
  },
  {
    role: "Consultant, Brainmates",
    detail:
      "Working with product managers across a broad portfolio of projects in payments, banking, education, contact centres and government.",
  },
];

const buttonClass =
  "border-accent hover:bg-accent hover:text-accent-foreground inline-block rounded-md border-2 px-5 py-2.5 font-semibold transition-colors";
---

<Layout
  title={`${about?.data.title ?? "About"} | ${config.site.title}`}
  description={about?.data.description}
  ogImage={about?.data.ogImage}
  canonicalURL={about?.data.canonicalURL}
>
  <Header />

  <main id="main-content" class="app-layout pb-16">
    <!-- Intro -->
    <section
      class="grid items-center gap-8 pt-10 pb-12 sm:grid-cols-[1fr_auto] sm:gap-12 sm:pt-14"
    >
      <div class="order-2 sm:order-1">
        <h1 class="text-4xl font-bold tracking-tight sm:text-5xl">
          Lisa Simons
        </h1>
        <p class="text-muted-foreground mt-2 text-lg sm:text-xl">
          Senior Business Analyst consultant, Sydney
        </p>
        <p class="mt-6 max-w-[60ch] text-lg leading-relaxed">
          I’m an expert in Business Analysis practices, having delivered
          technical requirements and operational designs on more than 20
          projects.
        </p>
        <p class="mt-3 max-w-[60ch] text-lg leading-relaxed">
          I naturally enjoy connecting the dots between products, technology
          and people.
        </p>
        <a href={linkedIn} target="_blank" rel="noopener" class:list={[buttonClass, "mt-8"]}>
          Connect on LinkedIn
        </a>
      </div>
      <img
        src="/images/2026LisaSimons.jpg"
        alt="Lisa Simons, Senior Business Analyst, Sydney"
        width="1086"
        height="1448"
        class="order-1 aspect-[3/4] w-36 rounded-lg object-cover sm:order-2 sm:w-52"
      />
    </section>

    <!-- What I do -->
    <section class="border-border border-t py-12">
      <h2 class="text-2xl font-semibold tracking-tight">What I do</h2>
      <div class="mt-8 grid gap-x-10 gap-y-8 sm:grid-cols-2">
        {
          areas.map(area => (
            <div class="border-accent border-t-2 pt-4">
              <h3 class="text-lg font-semibold">{area.name}</h3>
              <ul class="text-muted-foreground mt-2 space-y-1.5 leading-snug">
                {area.items.map(item => (
                  <li>{item}</li>
                ))}
              </ul>
            </div>
          ))
        }
      </div>

      <div class="mt-12 grid items-center gap-8 sm:grid-cols-[1fr_14rem] sm:gap-12">
        <div class="space-y-4 text-lg leading-relaxed">
          <p>
            My specialty is in adapting deliverables for enterprise-level
            projects to ensure business and product objectives are met.
          </p>
          <p>
            I have deep domain knowledge in Australian payments, in particular
            the NPP scheme (Osko, PayTo, PayID).
          </p>
        </div>

        <!-- Products / technology / people model -->
        <figure class="mx-auto w-52 sm:w-full" aria-hidden="true">
          <svg viewBox="0 0 240 210" class="w-full overflow-visible">
            <g class="stroke-accent" stroke-width="2">
              <line x1="120" y1="40" x2="45" y2="165"></line>
              <line x1="120" y1="40" x2="195" y2="165"></line>
              <line x1="45" y1="165" x2="195" y2="165"></line>
            </g>
            <g class="fill-background stroke-accent" stroke-width="2.5">
              <circle cx="120" cy="40" r="11"></circle>
              <circle cx="45" cy="165" r="11"></circle>
              <circle cx="195" cy="165" r="11"></circle>
            </g>
            <g class="fill-foreground" font-size="15" font-weight="600" text-anchor="middle">
              <text x="120" y="16">Products</text>
              <text x="45" y="198">Technology</text>
              <text x="195" y="198">People</text>
            </g>
          </svg>
        </figure>
      </div>
    </section>

    <!-- Background -->
    <section class="border-border border-t py-12">
      <h2 class="text-2xl font-semibold tracking-tight">Background</h2>
      <ol class="border-border mt-8 ml-1.5 border-l-2">
        {
          career.map((step, i) => (
            <li class="relative pb-8 pl-7 last:pb-0">
              <span
                class:list={[
                  "absolute top-1.5 -left-[7px] size-3 rounded-full",
                  i === career.length - 1
                    ? "bg-accent"
                    : "border-accent bg-background border-2",
                ]}
              />
              <h3 class="font-semibold">{step.role}</h3>
              <p class="text-muted-foreground mt-1 max-w-[60ch]">{step.detail}</p>
            </li>
          ))
        }
      </ol>

      <h3 class="mt-12 font-semibold">Education</h3>
      <ul class="text-muted-foreground mt-2 space-y-1.5">
        <li>Master of Engineering Management, UTS</li>
        <li>Bachelor of Engineering (Honours, Electrical), UNSW</li>
      </ul>
    </section>

    <!-- Contact -->
    <section class="bg-muted/40 rounded-lg px-6 py-8 sm:px-8">
      <h2 class="text-2xl font-semibold tracking-tight">Get in touch</h2>
      <p class="mt-3 max-w-[60ch] leading-relaxed">
        Contact me if you are looking to quickly establish an effective
        framework and requirements that enable your delivery teams to implement
        products that meet customer and user needs.
      </p>
      <a href={linkedIn} target="_blank" rel="noopener" class:list={[buttonClass, "mt-6"]}>
        Connect on LinkedIn
      </a>
      <p class="text-muted-foreground mt-8 text-sm">
        About this site: this is where I keep notes about ideas I am interested
        in.
      </p>
    </section>
  </main>

  <Footer />
</Layout>
